# ── Database ─────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nova?schema=public"

# ── Auth ─────────────────────────────────────────────
# 32+ random chars. Generate: openssl rand -hex 32
AUTH_SECRET=""
# Google sign-in (optional). Leave empty to hide it — the button shows as unavailable.
# Google Cloud Console → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Test-only overrides (used by tests/mock-google.mjs). Never set these in production.
# GOOGLE_AUTH_URL="http://localhost:4455/auth"
# GOOGLE_TOKEN_URL="http://localhost:4455/token"
# GOOGLE_JWKS_URL="http://localhost:4455/jwks"
# GOOGLE_ISSUER="http://localhost:4455"

# ── Email ────────────────────────────────────────────
# console (dev: prints to server log) | smtp | resend
EMAIL_PROVIDER="console"
EMAIL_FROM="NOVA <no-reply@yourdomain.com>"
EMAIL_REPLY_TO=""
# SMTP (Gmail app password, Zoho, SES SMTP, Mailgun, Brevo…)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
# Resend (https://resend.com) — verify your sending domain first
RESEND_API_KEY=""

# ── Payments ─────────────────────────────────────────
# mock | razorpay | stripe
PAYMENT_PROVIDER="mock"
PAYMENT_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
STRIPE_SECRET_KEY=""

# ── Storage ──────────────────────────────────────────
# local | cloudinary | s3
STORAGE_PROVIDER="local"
CLOUDINARY_URL=""
S3_BUCKET=""
S3_REGION=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
