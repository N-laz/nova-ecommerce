// NOVA — normalized relational schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  UPI
  CARD
  NET_BANKING
  COD
  TEST
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum DeliveryMethod {
  STANDARD
  EXPRESS
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum InventoryReason {
  PURCHASE
  RESTOCK
  ORDER
  ORDER_CANCELLED
  ADJUSTMENT
  DAMAGED
  RETURN
}

enum NotificationType {
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  ORDER_UPDATE
  PRICE_DROP
  BACK_IN_STOCK
  PROMOTIONAL
}

enum RewardType {
  EARNED
  REDEEMED
  REVERSED
  ADJUSTED
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

// ───────────────────────── Identity ─────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  phone         String?
  image         String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  cart          Cart?
  wishlist      Wishlist?
  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  couponUsages  CouponUsage[]
  notifications Notification[]
  rewardAccount RewardAccount?
  stockAlerts   StockAlert[]
  inventoryLogs InventoryTransaction[] @relation("InventoryActor")
  authTokens    AuthToken[]
  emailLogs     EmailLog[]

  // Email preferences. Security and order receipts are always sent.
  emailOrderUpdates Boolean @default(true)
  emailOffers       Boolean @default(true)

  @@index([role])
  @@index([createdAt])
}

/// OAuth-ready: one row per linked provider (e.g. "google").
model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  /// Email reported by the provider at link time (for display on the Security page).
  email             String?
  refreshToken      String?  @db.Text
  accessToken       String?  @db.Text
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Opaque server-side sessions. Only the SHA-256 hash of the token is stored.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ───────────────────────── Catalog ─────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  logo        String?
  featured    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  tagline          String?
  description      String        @db.Text
  price            Decimal       @db.Decimal(12, 2)
  compareAtPrice   Decimal?      @db.Decimal(12, 2)
  costPrice        Decimal?      @db.Decimal(12, 2)
  // Denormalized from price/compareAtPrice on every write — enables discount filtering & sorting.
  discountPercent  Int           @default(0)
  sku              String        @unique
  stock            Int           @default(0)
  lowStockThreshold Int          @default(5)
  status           ProductStatus @default(DRAFT)
  featured         Boolean       @default(false)
  trending         Boolean       @default(false)
  isFlashDrop      Boolean       @default(false)
  flashDropEndsAt  DateTime?
  tags             String[]      @default([])
  colors           String[]      @default([])
  warranty         String?
  // Denormalized, recomputed from approved reviews on every review change.
  ratingAvg        Decimal       @default(0) @db.Decimal(3, 2)
  ratingCount      Int           @default(0)
  soldCount        Int           @default(0)
  categoryId       String
  brandId          String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  category       Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand          Brand                  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  images         ProductImage[]
  specifications ProductSpecification[]
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  orderItems     OrderItem[]
  reviews        Review[]
  inventoryTxns  InventoryTransaction[]
  stockAlerts    StockAlert[]

  @@index([status, categoryId])
  @@index([status, brandId])
  @@index([status, price])
  @@index([status, createdAt])
  @@index([status, ratingAvg])
  @@index([status, soldCount])
  @@index([status, discountPercent])
  @@index([featured])
  @@index([trending])
  @@index([name])
}

/// Storage-agnostic image record. `url` may be a local /uploads path, Cloudinary or S3 URL.
model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  url        String
  storageKey String?
  provider   String   @default("local")
  alt        String?
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductSpecification {
  id        String  @id @default(cuid())
  productId String
  group     String  @default("General")
  key       String
  value     String
  position  Int     @default(0)
  filterable Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, key])
  @@index([key, value])
}

// ───────────────────────── Cart & Wishlist ─────────────────────────

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  guestToken String?    @unique
  couponId   String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user   User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items  CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  color     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, color])
  @@index([productId])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]
}

model WishlistItem {
  id            String   @id @default(cuid())
  wishlistId    String
  productId     String
  priceAtAdd    Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([productId])
}

model StockAlert {
  id         String    @id @default(cuid())
  userId     String
  productId  String
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId, notifiedAt])
}

// ───────────────────────── Checkout ─────────────────────────

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String   @default("Home")
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Order {
  id              String         @id @default(cuid())
  orderNumber     String         @unique
  userId          String
  status          OrderStatus    @default(PENDING)
  deliveryMethod  DeliveryMethod @default(STANDARD)
  // Address snapshot — orders must not change if an address is later edited/deleted.
  shipName        String
  shipPhone       String
  shipLine1       String
  shipLine2       String?
  shipCity        String
  shipState       String
  shipPincode     String
  subtotal        Decimal        @db.Decimal(12, 2)
  discountTotal   Decimal        @default(0) @db.Decimal(12, 2)
  pointsDiscount  Decimal        @default(0) @db.Decimal(12, 2)
  shippingFee     Decimal        @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal        @default(0) @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  pointsEarned    Int            @default(0)
  pointsRedeemed  Int            @default(0)
  couponId        String?
  couponCode      String?
  notes           String?
  estimatedDelivery DateTime?
  placedAt        DateTime       @default(now())
  confirmedAt     DateTime?
  packedAt        DateTime?
  shippedAt       DateTime?
  outForDeliveryAt DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user          User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon        Coupon?                @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  payments      Payment[]
  inventoryTxns InventoryTransaction[]
  couponUsage   CouponUsage?
  rewardTxns    RewardTransaction[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  // Snapshot of product at purchase time
  name        String
  sku         String
  image       String?
  color       String   @default("")
  unitPrice   Decimal  @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR")
  providerPaymentId String?       @unique
  providerOrderId   String?
  failureReason     String?
  metadata          Json?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

// ───────────────────────── Engagement ─────────────────────────

model Review {
  id               String       @id @default(cuid())
  userId           String
  productId        String
  rating           Int
  title            String
  comment          String       @db.Text
  verifiedPurchase Boolean      @default(true)
  status           ReviewStatus @default(APPROVED)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId, status, createdAt])
}

model Coupon {
  id              String       @id @default(cuid())
  code            String       @unique
  description     String?
  type            DiscountType
  value           Decimal      @db.Decimal(12, 2)
  minOrderAmount  Decimal      @default(0) @db.Decimal(12, 2)
  maxDiscount     Decimal?     @db.Decimal(12, 2)
  usageLimit      Int?
  perUserLimit    Int          @default(1)
  usedCount       Int          @default(0)
  startsAt        DateTime     @default(now())
  expiresAt       DateTime?
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  usages CouponUsage[]
  orders Order[]
  carts  Cart[]
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String   @unique
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
}

model InventoryTransaction {
  id          String          @id @default(cuid())
  productId   String
  change      Int
  reason      InventoryReason
  note        String?
  stockAfter  Int
  orderId     String?
  actorId     String?
  createdAt   DateTime        @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actor   User?   @relation("InventoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model RewardAccount {
  id             String   @id @default(cuid())
  userId         String   @unique
  balance        Int      @default(0)
  lifetimeEarned Int      @default(0)
  lifetimeUsed   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions RewardTransaction[]
}

model RewardTransaction {
  id          String     @id @default(cuid())
  accountId   String
  type        RewardType
  points      Int
  description String
  orderId     String?
  createdAt   DateTime   @default(now())

  account RewardAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  order   Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ─────────────────────────── Auth tokens & email ───────────────────────────

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFY
}

/// Single-use tokens for password reset and email verification. Only a hash is stored.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

/// Outbox + audit log for every transactional email. Secrets (reset/verify links) are redacted in `html`/`text`.
model EmailLog {
  id                String      @id @default(cuid())
  userId            String?
  to                String
  subject           String
  template          String
  html              String      @db.Text
  text              String      @db.Text
  status            EmailStatus @default(QUEUED)
  provider          String
  providerMessageId String?
  error             String?
  attempts          Int         @default(0)
  createdAt         DateTime    @default(now())
  sentAt            DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status])
  @@index([createdAt])
  @@index([template])
}
